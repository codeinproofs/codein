# Base URL of the CodeIn backend API (FastAPI).
# Leave empty / unset in dev to use the Vite proxy defined in vite.config.ts.
VITE_API_URL=http://localhost:8000

# Solana RPC endpoint used by the wallet adapter.
VITE_SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# "mainnet-beta" | "devnet" | "testnet"
VITE_SOLANA_NETWORK=mainnet-beta

# X (Twitter) profile URL — used on landing + in-app
VITE_X_URL=https://x.com/codein
