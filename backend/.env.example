# Copy to .env and fill in real values for production use.
# Any missing key below automatically activates the corresponding mock adapter.

ENVIRONMENT=development
DEBUG=true

# Postgres in production, e.g.:
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/codein
DATABASE_URL=sqlite+aiosqlite:///./codein.db

REDIS_URL=redis://localhost:6379/0

# OpenAI (GPT-4o for text/code, DALL-E 3 for icons). Leave blank to use MockAI.
OPENAI_API_KEY=
DALL_E_3_API_KEY=

# Pump.fun launch wallet + mint keypair. Leave blank to use the mock launcher.
PUMPFUN_MINT_KEYPAIR=
LAUNCH_WALLET=

# Vercel deployment token. Leave blank to use the mock deployer.
VERCEL_TOKEN=

CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Force mock mode for ALL adapters regardless of keys above (true/false).
# Leave unset to auto-detect per-adapter based on configured keys.
MOCK_MODE=
